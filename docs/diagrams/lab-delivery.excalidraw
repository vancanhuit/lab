      "seed": 1547985943,
      "version": 2,
      "versionNonce": 2020570455,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792505863513,
      "link": null,
      "locked": false,
      "text": "Ansible: service guests, kubeadm, containerd, Cilium / Hubble workloads, node firewalls, HAProxy.\nHelm: Argo CD release, including its HTTPS route; kubectl: bootstrap resources and Argo Applications.\nArgo Applications: the selected resources above, after deliberate adoption through manual sync.\nVault CLI: authentication roles, ACL policies, and KV data. ESO: generated Kubernetes Secret values.\nTechnitium UI: private DNS records and DHCP. These responsibilities have separate update workflows.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ansible: service guests, kubeadm, containerd, Cilium / Hubble workloads, node firewalls, HAProxy.\nHelm: Argo CD release, including its HTTPS route; kubectl: bootstrap resources and Argo Applications.\nArgo Applications: the selected resources above, after deliberate adoption through manual sync.\nVault CLI: authentication roles, ACL policies, and KV data. ESO: generated Kubernetes Secret values.\nTechnitium UI: private DNS records and DHCP. These responsibilities have separate update workflows.",
      "autoResize": true,
      "lineHeight": 1.35
    }
