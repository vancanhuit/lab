      "updated": 1792505865466,
      "link": null,
      "locked": false,
      "text": "/var/lib/lego holds ACME accounts, keys, and certs.\nHooks validate files and activate them per service.\nDNS consumes PFX; the other services consume PEM.\nVault reloads TLS with SIGHUP, preserving unsealed\nstate.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/var/lib/lego holds ACME accounts, keys, and certs.\nHooks validate files and activate them per service.\nDNS consumes PFX; the other services consume PEM.\nVault reloads TLS with SIGHUP, preserving unsealed\nstate.",
      "autoResize": true,
      "lineHeight": 1.35
    },
