      "seed": 1745521591,
      "version": 2,
      "versionNonce": 418788057,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792505863971,
      "link": null,
      "locked": false,
      "text": "Vault KV supplies values; ESO refreshes every minute.\nReal target Secrets use Orphan / Retain policies.\nSOPS files are encrypted recovery copies.\nAnsible uses ownership-scoped SOPS credentials.\nThe public Argo CLI client has no client secret.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vault KV supplies values; ESO refreshes every minute.\nReal target Secrets use Orphan / Retain policies.\nSOPS files are encrypted recovery copies.\nAnsible uses ownership-scoped SOPS credentials.\nThe public Argo CLI client has no client secret.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "custody",
      "type": "text",
      "x": 40,
      "y": 1590,
      "width": 1139.97802734375,
      "height": 29.700000000000003,
      "angle": 0,
      "strokeColor": "#536779",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 1551789881,
      "version": 2,
      "versionNonce": 1054720823,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792505863971,
      "link": null,
      "locked": false,
      "text": "Vault uses local Raft and manual Shamir unseal (3 of 5 shares); keep recovery custody independent of the lab host.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vault uses local Raft and manual Shamir unseal (3 of 5 shares); keep recovery custody independent of the lab host.",
      "autoResize": true,
      "lineHeight": 1.35
    }
