      "isDeleted": false,
      "boundElements": [],
      "updated": 1792505863971,
      "link": null,
      "locked": false,
      "text": "JWT audiences: vault + Kubernetes API.\nClient JWT also authorizes TokenReview.\nNo stored reviewer JWT or static Vault token.\nTokens: 10-minute TTL, one-hour hard maximum.\nOther namespaces cannot assume these Vault roles.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JWT audiences: vault + Kubernetes API.\nClient JWT also authorizes TokenReview.\nNo stored reviewer JWT or static Vault token.\nTokens: 10-minute TTL, one-hour hard maximum.\nOther namespaces cannot assume these Vault roles.",
      "autoResize": true,
      "lineHeight": 1.35
    },
