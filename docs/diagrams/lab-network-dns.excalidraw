      "seed": 1954665783,
      "version": 2,
      "versionNonce": 379495321,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792505862276,
      "link": null,
      "locked": false,
      "text": "DHCP pool: 10.205.234.100 to 10.205.234.200; stable reservations for service and node names.\nDHCP supplies router 10.205.234.1 and DNS 10.205.234.2. Static addresses stay outside that pool.\nIncus DNS and DHCP are disabled. Guests return tailnet traffic through their default gateway.\nInternal guests use OpenSSH; Tailscale SSH terminates on the Incus host.",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DHCP pool: 10.205.234.100 to 10.205.234.200; stable reservations for service and node names.\nDHCP supplies router 10.205.234.1 and DNS 10.205.234.2. Static addresses stay outside that pool.\nIncus DNS and DHCP are disabled. Guests return tailnet traffic through their default gateway.\nInternal guests use OpenSSH; Tailscale SSH terminates on the Incus host.",
      "autoResize": true,
      "lineHeight": 1.35
    },
