kubeProxyReplacement: true
envoy:
  enabled: true
  securityContext:
    capabilities:
      keepCapNetBindService: true
      envoy:
        - NET_ADMIN
        - SYS_ADMIN
        - NET_BIND_SERVICE
gatewayAPI:
  enabled: true
  enableProxyProtocol: true
  enableAppProtocol: true
  useRemoteAddress: true
  xffNumTrustedHops: 0
  gatewayClass:
    create: 'true'
  hostNetwork:
    enabled: true
    nodes:
      matchLabels:
        node-role.kubernetes.io/edge: ''
hubble:
  enabled: true
  ui:
    enabled: true
    rollOutPods: true
    service:
      type: ClusterIP
  relay:
    enabled: true
    rollOutPods: true
    service:
      type: ClusterIP
  tls:
    enabled: true
    auto:
      enabled: true
      method: cronJob
k8sServiceHost: {{ kubernetes_api_host }}
k8sServicePort: 6443
ipam:
  mode: kubernetes
routingMode: tunnel
tunnelProtocol: vxlan
ipv4:
  enabled: true
ipv6:
  enabled: false
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup
rollOutCiliumPods: true
operator:
  replicas: 2
  rollOutPods: true
