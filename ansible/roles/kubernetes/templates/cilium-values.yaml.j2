kubeProxyReplacement: true
envoy:
  enabled: true
hubble:
  enabled: true
  relay:
    enabled: true
    rollOutPods: true
    service:
      type: ClusterIP
  tls:
    enabled: true
    auto:
      enabled: true
      method: cronJob
k8sServiceHost: {{ kubernetes_api_host }}
k8sServicePort: 6443
ipam:
  mode: kubernetes
routingMode: tunnel
tunnelProtocol: vxlan
ipv4:
  enabled: true
ipv6:
  enabled: false
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup
rollOutCiliumPods: true
operator:
  replicas: 2
