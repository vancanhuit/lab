server {
    listen {{ seaweedfs_s3_port }} ssl;
    listen [::]:{{ seaweedfs_s3_port }} ssl;
    server_name {{ seaweedfs_domain }};

    ssl_certificate {{ seaweedfs_tls_cert_path }};
    ssl_certificate_key {{ seaweedfs_tls_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://{{ seaweedfs_s3_bind_address }}:{{ seaweedfs_s3_internal_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
